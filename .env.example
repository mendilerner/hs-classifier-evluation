# Copy to .env and change what you need. Every value below has a default;
# add here any settings mlflowfunctions needs on your machine.

# ── Agent ──────────────────────────────────────────────────────────────────
AGENT_URL=https://langraph-infrastructure.mdev.mehes.gov.il/api/v1/agents/run
AGENT_NAME=hscode_manager
THREADS_NUMBER=16
REQUEST_TIMEOUT_SECONDS=600

# ── Auth: either a username (default) or a service token ───────────────────
USERNAME_FOR_AGENT=dev-user
USE_TOKEN_AUTH=false
# only when USE_TOKEN_AUTH=true
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
CURA_AUTH_ENV=dev
KEYCLOAK_REALM=entic

# ── Test ───────────────────────────────────────────────────────────────────
# Repeat the whole test set this many times; metrics are averaged. Use >= 3
# when comparing two server versions - a single run varies by about +-15
# correct answers on its own.
NUM_RUNS=1

# ── MLflow ─────────────────────────────────────────────────────────────────
EXPERIMENT_NAME=hs-classifier-verified-products
EXPERIMENT_DESCRIPTION=
# defaults to run-<date>-<time>
RUN_NAME=
RUN_DESCRIPTION=

# What the server ran with. The test can't see or set these (the server
# decides), so write them down here; they are logged as MLflow params.
MODEL_USED_FOR_CANDIDATES_GENERATION=
MODEL_USED_FOR_PROCESS=
LLM_DIRECT_PROMPT=
# anything else that differs between runs, e.g. "web search on, Milvus prod"
SERVER_NOTES=
